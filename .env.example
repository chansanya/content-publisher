# FTP 服务器地址（必填）
FTP_HOST=ftp.example.com

# FTP 端口，不填默认 21
FTP_PORT=21

# 登录用户名（必填）
FTP_USER=username

# 登录密码（必填，界面只显示 ***，不会进日志和记录）
FTP_PASSWORD=password

# 固定远程根目录（必填）
# 必须是安全的绝对路径；空、相对路径、. 、.. 、/ 都会被拒绝
# 该目录是独占部署槽位：每次发布/回滚会清空其内部全部内容
FTP_REMOTE_ROOT=/fixed/publish/path

# 连接协议：true = 显式 FTPS（默认）；只有明确设为 false 才用普通 FTP
# FTPS 连接失败不会自动降级为 FTP
FTP_SECURE=true

# TLS 证书校验：true = 严格校验（默认）；自签名证书环境可设为 false
FTP_TLS_REJECT_UNAUTHORIZED=true

# 服务端 ZIP 部署接口（必填，指向 resources/deploy.php 在网站上的地址）
DEPLOY_ENDPOINT=https://www.example.com/.ftppublisher/deploy.php

# 部署接口密钥（必填，至少 8 位；若包含 # 必须用引号包裹）
DEPLOY_TOKEN="replace-with-random-token"

# 发布记录目录（本地），相对路径基于 .env 所在目录，不填默认 ./historical
# 保存记录索引 index.json 和不可变版本 artifacts/<releaseId>/
PUBLISH_RECORD_DIR=./.historical
