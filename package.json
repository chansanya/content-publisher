{
  "name": "ftp-publisher",
  "version": "1.0.0",
  "description": "内容发布工具 - Windows x64 FTP 完整版本发布与回滚工具",
  "main": "dist/main/index.js",
  "author": "lhy",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "start:electron": "electron .",
    "build:main": "vite build -c vite.main.config.ts",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:zip": "npm run build && electron-builder --win zip --x64",
    "release": "gh workflow run build --ref master",
    "release:watch": "gh run watch --exit-status"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "element-plus": "^2.8.0",
    "ignore": "^5.3.1",
    "lucide-vue-next": "^0.441.0",
    "pinia": "^2.2.2",
    "sirv": "^3.0.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.6",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  }
}
